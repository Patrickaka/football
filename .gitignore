# JetBrains IDE
.idea/

# 文档
docs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 日志
logs/

# 运行时生成的数据（data/ 下）
elo_ratings.json
data/elo_ratings.json
data/backtest_data/
data/dynamic_threshold_config.json

# 运行时动态写入的历史缓存（可从网络重抓）
data/doc_store_*.json
# 写入过程中的半成品。原本只忽略了 .json，.tmp 变体一直是「未忽略的
# 未跟踪文件」，一次 `git add -A` 就会把 60 万行临时数据提进来。
data/doc_store_*.json.tmp
data/kv_store_fallback.json

# 预测缓存（运行时生成，重启自动重建）
data/*_cache.json
data/server_cache_*.json
src/football/cache/
src/beidan/cache/

# 运行时抓取的开奖历史与快照（可重建）
data/kl8_history.json
# 双色球玩法已下线，这两份历史是 `git add -A` 误提交进来的死数据
data/ssq_history.json
data/ssq_history_full.json
data/kl8_recalculations/
data/kl8_settlements/
data/kl8_snapshots/

# 运行时生成的分析报告
reports/

# 线上运行时持续写入的数据（不入 git，避免每次发版 pull 冲突）
src/football/data/prediction_history.json
data/calibration_db.json
data/market_score_db.json
data/market_cluster_db.json

# 快乐8策略持久化（测试/线上运行时写入）
data/kl8_active_strategies.json
data/kl8_strategy_trials.json
# 号码冲突的人工审核队列，跑分析器就会生成
data/kl8_conflict_queue.json

# 部署脚本写入，健康检查据此确认运行进程确实加载了目标提交
data/deployed_revision

# CatBoost 训练产物
catboost_info/

# SDD 执行工作区（账本/简报/审查包，非产物）
.superpowers/
